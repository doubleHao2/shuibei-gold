{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuibei-gold",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
